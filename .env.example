# Copie para .env.local (desenvolvimento) ou configure no painel da hospedagem.
# Nunca coloque segredos em variáveis NEXT_PUBLIC_*: elas vão para o navegador.

# ── Público ──────────────────────────────────────────────────────────────
# URL pública sem barra final. Usada em canonical, sitemap e Open Graph.
# Quando definida (ou em VERCEL_ENV=production), o robots.txt libera a indexação.
NEXT_PUBLIC_SITE_URL=

# WhatsApp profissional, só dígitos com DDI (ex.: 5511999999999). Vazio oculta o canal.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endereço usado nas URLs de retorno do Stripe (sucesso e cancelamento), sem barra final.
# Vazio usa a origem da própria requisição (bom para localhost e prévias da Vercel).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave publicável do Stripe. O Checkout hospedado não precisa dela (o servidor devolve a URL
# da sessão); fica aqui para uma futura integração com Stripe Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Analytics 4, ex.: G-XXXXXXXXXX. Vazio = sem banner, script ou coleta.
# Ativar somente após desabilitar a medição otimizada no fluxo GA4 (docs/lead-automation.md).
# A coleta depende da permissão do visitante; exige novo build após alteração.
# Também registra o funil de contratação (modal, pré-contratação, checkout e compra).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Link de agendamento do kickoff (Cal.com, Calendly...), usado na página de confirmação
# e no e-mail ao cliente. Vazio = agendamento pelo WhatsApp.
NEXT_PUBLIC_SCHEDULING_URL=

# ── Somente servidor ─────────────────────────────────────────────────────
# Adaptador de e-mail do formulário: "resend" (produção) ou "test" (testes locais,
# guarda as mensagens em memória e não envia nada). Vazio = formulário indisponível (503).
EMAIL_PROVIDER=

# Chave da API do Resend (https://resend.com). Obrigatória com EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Remetente verificado no provedor, ex.: "Site Renan Augusto <contato@seudominio.com.br>".
CONTACT_FROM_EMAIL=

# Destinatário das mensagens. Vazio usa o e-mail público do site.
CONTACT_TO_EMAIL=

# Limitador de requisições global (recomendado em serverless). Vazio usa memória local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe (pagamentos) ──────────────────────────────────────────────────
# Chave secreta (sk_test_... em teste, sk_live_... em produção). Vazio = sem pagamento online:
# o modal registra o pedido e oferece o WhatsApp.
STRIPE_SECRET_KEY=sk_test_...

# Segredo do endpoint de webhook (/api/webhooks/stripe), mostrado no painel do Stripe
# ou pelo comando "stripe listen" em desenvolvimento.
STRIPE_WEBHOOK_SECRET=whsec_...

# Métodos de pagamento aceitos no Checkout, separados por vírgula (precisam estar ativos
# no painel do Stripe). Vazio = card,pix,boleto. A assinatura mensal usa só cartão.
STRIPE_PAYMENT_METHODS=

# "true" liga o parcelamento no cartão (precisa estar liberado na conta Stripe).
STRIPE_CARD_INSTALLMENTS=

# Opcional: token do GitHub (só leitura de repositórios públicos) para importar os projetos
# do GitHub sem esbarrar no limite de requisições da API.
GITHUB_TOKEN=

# Integração opcional de pedidos com CRM/n8n. HTTPS; nunca usar NEXT_PUBLIC_.
# O destino precisa validar Authorization: Bearer <token> e deduplicar pelo ID.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=
